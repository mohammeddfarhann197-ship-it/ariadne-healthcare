<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ariadne</title><meta name="description" content="Guided orthopaedic recovery and minimal gear."><meta name="theme-color" content="#0a0a0a">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@1,400&display=swap">
<style>
:root{--bg:#0a0a0a;--c1:#141414;--c2:#1c1c1c;--ln:#262626;--tx:#f5f5f5;--mu:#9a9a9a;--g:#10b981;--g2:#00ff66;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*:before,*:after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.55 -apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display",system-ui,"Segoe UI",Inter,sans-serif;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent}
button,input{font:inherit;color:inherit}
button{cursor:pointer;min-height:44px}
:focus-visible{outline:2px solid var(--g2);outline-offset:2px}
.serif{font-family:Fraunces,Georgia,serif;font-style:italic}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--ln)}
.brand{display:flex;align-items:center;gap:10px;letter-spacing:.3em;font-size:13px;background:none;border:0}
nav{display:flex;gap:4px;flex-wrap:wrap}
nav button{background:none;border:0;color:var(--mu);padding:0 12px;border-radius:8px}
nav button.on,nav button:hover{color:var(--tx)}
nav button.on{box-shadow:inset 0 -2px var(--g)}
.btn{background:var(--g);color:#000;border:0;border-radius:12px;padding:0 22px;font-weight:600;transition:background .2s,box-shadow .2s}
.btn:hover{background:var(--g2);box-shadow:0 0 20px rgba(16,185,129,.45)}
.btn:disabled{opacity:.4;pointer-events:none}
.ghost{background:none;border:1px solid var(--ln);border-radius:12px;padding:0 18px}
.ghost:hover{border-color:var(--g)}
.card{background:var(--c1);border:1px solid var(--ln);border-radius:16px;padding:18px;transition:border-color .2s}
.card:hover{border-color:rgba(16,185,129,.5)}
main{padding:36px 0 60px;animation:in .45s cubic-bezier(.22,1,.36,1)}
@keyframes in{from{opacity:0;transform:translateX(24px)}}
@keyframes draw{to{stroke-dashoffset:0}}
.logo path{stroke-dasharray:140;stroke-dashoffset:140;animation:draw 1.5s ease forwards}
.center{min-height:80vh;display:flex;flex-direction:column;justify-content:center;max-width:520px;margin:0 auto}
blockquote{margin:28px 0;padding-left:20px;border-left:2px solid var(--g);font-size:26px;line-height:1.35}
cite{display:block;font:13px -apple-system,BlinkMacSystemFont,"SF Pro Text",system-ui,sans-serif;font-style:normal;color:var(--mu);margin-top:10px}
input[type=text],input[type=email],input[type=password],input[type=tel]{width:100%;min-height:48px;background:var(--c1);border:1px solid var(--ln);border-radius:12px;padding:0 14px;margin:6px 0 12px}
input:focus{border-color:var(--g);outline:0;box-shadow:0 0 14px rgba(16,185,129,.3)}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
.two{display:grid;gap:28px;grid-template-columns:1fr 1fr;align-items:start}
.mu{color:var(--mu);font-size:13px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}
.chip{border:1px solid var(--ln);background:none;border-radius:99px;padding:0 16px}
.chip.on,.chip:hover{border-color:var(--g);color:var(--g2)}
.art{background:linear-gradient(135deg,var(--c2),#000);border-radius:12px;aspect-ratio:4/3;display:grid;place-items:center;margin-bottom:12px}
.price{font-weight:600}.lnk{background:none;border:0;padding:0;min-height:0;text-align:left;font:inherit;font-weight:600}.lnk:hover{color:var(--g2)}.code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600;font-size:.9em;color:var(--g2)}details{border-bottom:1px solid var(--ln)}summary{cursor:pointer;min-height:44px;display:flex;align-items:center}.drawer.left{right:auto;left:0;border-left:0;border-right:1px solid var(--ln);transform:translateX(-100%)}.drawer.left.open{transform:none}
.recovery-top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.recovery-top h1{font-weight:400;margin:0;font-size:36px;letter-spacing:-.035em}.recovery-top p{margin:8px 0 0;max-width:540px}.recovery-layout{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.4fr);gap:16px;align-items:start}.recovery-card{padding:24px}.recovery-card h2{font-size:16px;margin:0 0 6px;letter-spacing:-.01em}.recovery-card .intro{margin:0 0 22px}.pain-value{display:flex;align-items:baseline;gap:7px;margin:24px 0 10px}.pain-value strong{font-size:44px;line-height:1;letter-spacing:-.06em;font-weight:500}.pain-value span{color:var(--mu);font-size:13px}.pain-range{width:100%;accent-color:var(--g);margin:12px 0 4px}.range-labels{display:flex;justify-content:space-between;color:var(--mu);font-size:11px}.recovery-card label{display:block;font-size:13px;font-weight:500}.recovery-note{resize:vertical;min-height:94px;padding:12px 14px!important}.recovery-submit{width:100%;margin-top:8px}.privacy-note{display:flex;gap:9px;align-items:flex-start;margin:16px 0 0;color:var(--mu);font-size:12px;line-height:1.5}.recovery-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0}.metric{padding:14px;background:var(--c2);border-radius:12px}.metric span{display:block;color:var(--mu);font-size:11px;letter-spacing:.04em;text-transform:uppercase}.metric b{display:block;font-size:21px;font-weight:500;margin-top:5px}.trend-chart{width:100%;height:160px;display:block;margin:8px 0 2px;overflow:visible}.history{margin-top:22px}.history-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}.history-title h3{font-size:14px;margin:0}.history-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid var(--ln)}.history-date{font-size:13px}.history-note{color:var(--mu);font-size:12px;margin-top:2px}.score-pill{border:1px solid var(--ln);border-radius:99px;padding:5px 10px;font-size:12px;white-space:nowrap}.score-pill i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--g);margin:0 6px 1px 0}.empty-chart{height:160px;display:grid;place-items:center;text-align:center;border:1px dashed var(--ln);border-radius:12px;margin-top:18px;padding:20px}.empty-chart p{max-width:260px;margin:0}
.ai{background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.3);border-radius:14px 14px 14px 4px;padding:12px 14px;box-shadow:0 0 15px rgba(16,185,129,.25);margin-bottom:12px}
.me{background:var(--c2);border:1px solid var(--ln);border-radius:14px 14px 4px 14px;padding:10px 14px;margin:0 0 12px auto;width:fit-content}
.body{position:relative;width:156px;margin:0 auto;animation:sway 7s ease-in-out infinite alternate}.body:hover{animation-play-state:paused}@keyframes sway{from{transform:perspective(700px) rotateY(-7deg)}to{transform:perspective(700px) rotateY(7deg)}}
.dot{position:absolute;width:44px;height:44px;margin:-22px;border-radius:50%;background:none;border:0}
.dot:after{content:"";position:absolute;inset:15px;border-radius:50%;background:var(--mu)}
.dot.on:after,.dot:hover:after{background:var(--g2);box-shadow:0 0 12px var(--g2)}
.bar{height:4px;background:var(--ln);border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--g);box-shadow:0 0 10px var(--g)}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(380px,100%);background:var(--c1);border-left:1px solid var(--ln);padding:20px;transform:translateX(100%);transition:transform .45s cubic-bezier(.22,1,.36,1);z-index:20;overflow:auto}
.drawer.open{transform:none}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--ln)}
#toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,80px);background:var(--c1);border:1px solid rgba(16,185,129,.5);padding:12px 18px;border-radius:12px;transition:transform .3s;z-index:30}
#toast.show{transform:translate(-50%,0)}
.finder-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}.finder-heading h1{font-weight:400;margin:0;font-size:34px;letter-spacing:-.035em}.finder-heading p{margin:6px 0 0}.finder-layout{display:grid;grid-template-columns:minmax(230px,.8fr) minmax(320px,1.2fr);gap:16px;align-items:stretch}.finder-visual,.finder-panel{background:var(--c1);border:1px solid var(--ln);border-radius:18px;padding:20px}.finder-visual{display:flex;flex-direction:column;justify-content:center;min-height:430px}.finder-figure{display:flex;justify-content:center;align-items:center;min-height:320px}.finder-figure svg{width:156px;height:auto}.finder-visual .tabs{gap:6px;justify-content:center;margin:14px 0 0}.finder-visual .chip{min-height:36px;padding:0 12px;font-size:12px}.finder-panel{min-height:430px;display:flex;flex-direction:column;justify-content:center}.finder-step{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--g);margin-bottom:10px}.finder-panel h2{font-size:22px;font-weight:500;letter-spacing:-.025em;margin:0 0 6px}.finder-panel>.mu{margin:0 0 18px}.finder-panel .ai{box-shadow:none}.finder-panel .tabs{margin:14px 0}.finder-panel .recommendation{margin-top:12px}.finder-panel .grid{grid-template-columns:1fr}.finder-panel .card{padding:14px}.finder-panel .card .art{aspect-ratio:3/1}.finder-panel .card .art svg{width:90px;height:68px}.finder-panel .card h3{font-size:14px}.finder-panel .card .row .btn{padding:0 14px}.finder-panel .bar{margin-top:8px}
@media(max-width:760px){.two{grid-template-columns:1fr}.recovery-layout{grid-template-columns:1fr}.recovery-top{align-items:flex-start;flex-direction:column;gap:8px}.recovery-top h1{font-size:32px}.recovery-card{padding:19px}blockquote{font-size:22px}}
@media(max-width:700px){.finder-layout{grid-template-columns:1fr;gap:12px}.finder-panel{order:0}.finder-visual{order:1}.finder-visual,.finder-panel{min-height:0;padding:16px}.finder-figure{min-height:250px}.finder-figure svg{width:128px}.finder-panel{padding:22px}.finder-heading{align-items:flex-start;flex-direction:column;gap:4px}.finder-heading h1{font-size:30px}.finder-visual .tabs{gap:4px}.finder-visual .chip{padding:0 10px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.logo path{stroke-dashoffset:0}}
</style></head><body>
<div class="wrap" id="app"></div>
<aside class="drawer" id="drawer" aria-label="Cart"></aside>
<div id="toast" role="status"></div>
<button class="btn" data-help style="position:fixed;left:16px;bottom:16px;z-index:25;border-radius:99px">Help</button>
<aside class="drawer left" id="hp" aria-label="Help"><div class="row"><b>Help</b><button class="ghost" data-hclose>Close</button></div><div class="ai" style="margin-top:14px">Hi, I’m Ariadne. Pick a question below.</div><details><summary>How do I choose a size?</summary><p class="mu">Measure the area in cm and compare it with the size on each product page.</p></details><details><summary>What is the returns policy?</summary><p class="mu">Free returns within 7 days, and a 6-month warranty on gear.</p></details><details><summary>Is Find Gear medical advice?</summary><p class="mu">No. It gives guidance only. See a doctor if pain is severe or persists.</p></details><details><summary>Is the pain relief safe to use?</summary><p class="mu">We sell over-the-counter topicals only. Use as directed and ask a pharmacist if unsure.</p></details><details><summary>Can I pay on delivery?</summary><p class="mu">Cash on Delivery shows as available once you enter a valid PIN code.</p></details></aside>
<script>
const M='<path d="M5 36 22 5 39 36M11 26h22c7 0 7 10-1 9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>';
const logo=(s=28)=>`<svg class="logo" width="${s}" height="${s}" viewBox="0 0 44 40" style="color:var(--tx)">${M}</svg>`;
const P=[
['Exo-Stabilizer Hinged Knee Brace',6499,'Braces','Knee','Hinged polycentric support with carbon-fibre composite.'],
['Ankle Stabilizer',3299,'Braces','Ankle','Firm lateral support for twists and sprains.'],
['Lumbar Support Belt',4199,'Supports','Lower back','Steady compression for long days.'],
['Wrist Splint',1899,'Supports','Wrist','Keeps the wrist neutral while it heals.'],
['Shoulder Stabilizer',3799,'Braces','Shoulder','Gentle cross-body support.'],
['Tennis Elbow Strap',1299,'Supports','Elbow','Eases load on the forearm tendon.'],
['Compression Knee Sleeve',1499,'Sleeves','Knee','Light warmth and support for daily wear.'],
['Compression Calf Sleeve',1199,'Sleeves','Ankle','Graduated compression for recovery.'],
['Posture Corrector',2299,'Supports','Neck','Cues your shoulders back.'],
['Cooling Pain Relief Gel, 100 g',349,'Pain Relief','Any','Topical gel. Use as directed.'],
['Heat Relief Patches, pack of 5',299,'Pain Relief','Any','Topical patches. Use as directed.'],
['Fast Relief Spray, 100 ml',449,'Pain Relief','Any','Topical spray. Use as directed.']];
const REC={Knee:0,Ankle:1,'Lower back':2,Wrist:3,Shoulder:4,Elbow:5,Neck:8};
const fmt=n=>'₹'+n.toLocaleString('en-IN');
let S={v:'welcome',name:'',cat:'All',cart:{},f:{},log:[],code:null,p:0,q:'',sz:'M',wish:{}};
try{S.name=localStorage.getItem('ariadne-name')||'';Object.assign(S,JSON.parse(localStorage.getItem('ariadne-state')||'{}'))}catch(e){}
const art=i=>{const r=P[i][2]=='Pain Relief';return `<div class="art"><svg width="120" height="90" viewBox="0 0 120 90">${r?'<rect x="44" y="8" width="32" height="74" rx="8" fill="#242424"/><rect x="50" y="2" width="20" height="10" rx="3" fill="#333"/>':'<rect x="22" y="14" width="76" height="62" rx="18" fill="#242424"/><rect x="22" y="30" width="76" height="8" fill="#2e2e2e"/><rect x="22" y="52" width="76" height="8" fill="#2e2e2e"/>'}<g transform="translate(48 ${r?34:30}) scale(.55)" style="color:#555">${M}</g></svg></div>`};
const $=s=>document.querySelector(s);
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('show'),2600)}
function go(v){S.v=v;if(v=='finder')S.f={};render();scrollTo(0,0)}
const count=()=>Object.values(S.cart).reduce((a,b)=>a+b,0);
const tot=()=>{let sub=0,dis=0;const c=S.code;Object.keys(S.cart).forEach(i=>{const v=P[i][1]*S.cart[i];sub+=v;if(c&&(!c[3]||P[i][2]==c[3]))dis+=Math.round(v*c[2]/100)});const ship=!sub||sub-dis>=1500?0:99;return{sub,dis,ship,t:sub-dis+ship}};
const shopList=()=>P.map((p,i)=>i).filter(i=>(S.cat=='All'||P[i][2]==S.cat)&&P[i][0].toLowerCase().includes(S.q)).map(card).join('');
const PROMOS=[['ARIADNE10','all gear',10,null],['BRACE10','braces',10,'Braces'],['SLEEVE15','sleeves',15,'Sleeves'],['SUPPORT12','supports',12,'Supports'],['RELIEF5','pain relief',5,'Pain Relief']];
const promo=i=>{const p=PROMOS[i%PROMOS.length];return 'Use <b class="code">'+p[0]+'</b> for '+p[2]+'% off '+p[1]+'. Free delivery above ₹1,500.'};
let pi=0;setInterval(()=>{const e=$('#promo');if(e)e.innerHTML=promo(++pi)},4000);
function head(){return `<div id="promo" class="mu" style="text-align:center;padding:8px;border-bottom:1px solid var(--ln)">${promo(pi)}</div><header><button class="brand" data-go="home" aria-label="Ariadne home">${logo(26)}ARIADNE</button><nav aria-label="Main">${[['home','Home'],['finder','Find Gear'],['shop','Shop'],['saved','Saved'],['log','Recovery']].map(([k,l])=>`<button data-go="${k}" class="${S.v==k?'on':''}">${l}</button>`).join('')}<button data-cart>Cart (${count()})</button></nav></header>`}
function card(i){const p=P[i];return `<article class="card"><div class="row" style="border:0;padding:0"><span class="mu">Ariadne Gear · ${p[2]}</span><button class="lnk" data-wish="${i}" aria-label="Save to wishlist" style="min-height:44px;min-width:44px;font-size:20px;text-align:center;color:${S.wish[i]?'var(--g2)':'var(--mu)'}">${S.wish[i]?'♥':'♡'}</button></div>${art(i)}<h3 style="margin:4px 0"><button class="lnk" data-open="${i}">${p[0]}</button></h3><p class="mu" style="margin:0 0 10px">${p[4]}</p><div class="row" style="border:0;padding:0"><span class="price">${fmt(p[1])}</span><button class="btn" data-add="${i}" style="min-height:44px">Add</button></div></article>`}
const views={
welcome:()=>`<div class="center"><div>${logo(64)}<div style="letter-spacing:.35em;margin-top:10px">ARIADNE</div></div><blockquote class="serif">“Medicine is the science of healing, and its primary duty is the immediate mitigation of human suffering.”<cite>Scribonius Largus, Roman Physician</cite></blockquote><label for="n">What should we call you?</label><input id="n" type="text" autocomplete="given-name" value="${S.name}"><button class="btn" id="cont" style="width:100%">Continue</button><p class="mu" id="hint">Enter at least 2 characters.</p></div>`,
signin:()=>`<div class="center"><h1 class="serif" style="font-weight:400">Welcome, ${S.name}.</h1><div class="tabs"><button class="chip on" data-tab="in">Sign in</button><button class="chip" data-tab="up">Create account</button></div><form id="f"><label>Email<input type="email" required></label><label>Password<input type="password" required minlength="6"></label><label id="ph" hidden>Phone<input type="tel"></label><button class="btn" style="width:100%">Sign in</button></form><p class="mu">Your recovery data stays private. This demo accepts any valid email.</p></div>`,
home:()=>`<div class="two"><div><h1 class="serif" style="font-size:40px;font-weight:400;margin:0 0 12px">Good to see you, ${S.name}.</h1><p class="mu" style="font-size:16px">Ariadne guides you from first symptom to full strength.</p><div class="tabs"><button class="btn" data-go="finder">Find my gear</button><button class="ghost" data-go="shop">Shop all</button></div></div><blockquote class="serif" style="font-size:20px">“Medicine is the science of healing…”<cite>Scribonius Largus</cite></blockquote></div>
<h2>Your path</h2><div class="grid">${['Tell us where it hurts','Answer a few questions','Get the right gear'].map((t,i)=>`<div class="card"><div class="mu">Step ${i+1}</div><h3 style="margin:6px 0 0">${t}</h3></div>`).join('')}</div>
<h2 style="margin-top:36px">Featured</h2><div class="grid">${[0,1,2,9].map(card).join('')}</div>
<h2 style="margin-top:36px">Recovery timeline</h2><div class="grid">${[['Protect','Stabilize and reduce load.'],['Restore','Rebuild range of motion.'],['Strengthen','Load progressively.'],['Perform','Return to full activity.']].map(([a,b],i)=>`<div class="card" style="${i==0?'border-color:var(--g)':''}"><h3 style="margin:0;${i==0?'color:var(--g2)':''}">${a}</h3><p class="mu" style="margin:4px 0 0">${b}${i==0?' You are here.':''}</p></div>`).join('')}</div>
<p class="mu" style="margin-top:40px">Ariadne provides guidance and is not a substitute for professional medical advice.</p>`,
shop:()=>`<h1 class="serif" style="font-weight:400;margin:0">Ariadne Gear</h1><p class="mu">Support, built minimal. Free delivery above ₹1,500.</p><div class="tabs">${['All','Braces','Supports','Sleeves','Pain Relief'].map(c=>`<button class="chip ${S.cat==c?'on':''}" data-cat="${c}">${c}</button>`).join('')}</div><input id="q" type="text" placeholder="Search gear" value="${S.q}"><div class="grid" id="g">${shopList()}</div>${S.cat=='Pain Relief'||S.cat=='All'?'<p class="mu" style="margin-top:24px">Ariadne sells only over-the-counter topical pain relief. Consult a pharmacist or doctor if unsure.</p>':''}`,
saved:()=>{const ids=Object.keys(S.wish).filter(i=>S.wish[i]);return `<h1 class="serif" style="font-weight:400;margin:0 0 16px">Saved</h1>${ids.length?`<div class="grid">${ids.map(card).join('')}</div>`:'<p class="mu">Nothing saved yet. Tap the heart on any product.</p>'}`},
product:()=>{const i=S.p,p=P[i],gear=p[2]!='Pain Relief';return `<button class="ghost" data-go="shop">Back to shop</button><div class="two" style="margin-top:16px"><div>${art(i)}</div><div><div class="mu">Ariadne Gear · ${p[2]}</div><h1 class="serif" style="font-weight:400;margin:4px 0">${p[0]}</h1><p class="price" style="font-size:22px;margin:0">${fmt(p[1])}</p><p class="mu">Inclusive of all taxes</p><p>${p[4]}</p>${gear?`<div class="tabs">${['S','M','L','XL'].map(s=>`<button class="chip ${S.sz==s?'on':''}" data-sz="${s}">${s}</button>`).join('')}</div>`:''}<button class="btn" data-add="${i}" style="width:100%">Add to cart</button><p class="mu">Free returns in 7 days · 6-month warranty · Secure checkout</p></div></div><h2>Reviews</h2><div class="grid">${['Fits well and feels light all day.','Steady support in my first weeks back to walking.','Simple, clean, and comfortable.'].map(t=>`<div class="card"><b>★★★★★</b> <span class="mu">Sample review</span><p>${t}</p></div>`).join('')}</div><h2>Pairs well with</h2><div class="grid">${card(i==9?0:9)}</div>`},
checkout:()=>{const T=tot();return `<h1 class="serif" style="font-weight:400">Checkout</h1><div class="two"><form id="co"><label>Full name<input type="text" required value="${S.name}"></label><label>Phone<input type="tel" required pattern="[0-9]{10}" title="10 digits"></label><label>PIN code<input type="text" id="pin" required pattern="[0-9]{6}" inputmode="numeric" maxlength="6"></label><p class="mu" id="eta">Enter your PIN code for a delivery estimate.</p><b>Payment (demo only)</b><div class="tabs">${['UPI','Card','Net banking','Cash on Delivery'].map((m,k)=>`<label class="chip" style="display:inline-flex;align-items:center;gap:8px"><input type="radio" name="pay" ${k?'':'checked'}>${m}</label>`).join('')}</div><button class="btn" style="width:100%">Place order · ${fmt(T.t)}</button></form><div class="card"><b>Summary</b><div class="row"><span>Subtotal</span><span>${fmt(T.sub)}</span></div>${T.dis?`<div class="row"><span>Code <b class="code">${S.code[0]}</b></span><span>−${fmt(T.dis)}</span></div>`:''}<div class="row"><span>Delivery</span><span>${T.ship?fmt(T.ship):'Free'}</span></div><div class="row"><b>Total, GST included</b><b>${fmt(T.t)}</b></div></div></div>`},
done:()=>`<h1 class="serif" style="font-weight:400">Order placed, ${S.name}.</h1><p>Order ${S.order}. Your recovery begins here.</p><div class="grid">${['Placed','Packed','Shipped','Delivered'].map((s,k)=>`<div class="card" style="${k?'':'border-color:var(--g)'}"><b style="${k?'':'color:var(--g2)'}">${s}</b></div>`).join('')}</div><p><button class="btn" data-go="shop">Keep shopping</button></p>`,
log:()=>{const L=S.log,ordered=[...L].reverse(),avg=L.length?(L.reduce((a,e)=>a+e.s,0)/L.length).toFixed(1):'—',first=L[0],last=L[L.length-1],change=first&&last?last.s-first.s:null,trend=change===null?'—':change<0?`${Math.abs(change)} lower`:change>0?`${change} higher`:'steady',points=L.map((e,k)=>`${L.length<2?140:k*(280/(L.length-1))},${Math.max(8,Math.min(92,100-e.s*9))}`).join(' '),safe=t=>String(t||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),date=e=>e.d?new Date(e.d).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}):'Earlier entry';return `<section class="recovery-top"><div><div class="mu" style="letter-spacing:.12em;text-transform:uppercase;font-size:11px">Your wellbeing</div><h1 class="serif">Recovery</h1><p class="mu">A small check-in can make progress easier to see. Track how you feel, one day at a time.</p></div></section><div class="recovery-layout"><form id="lg" class="card recovery-card"><div class="mu" style="text-transform:uppercase;letter-spacing:.1em;font-size:10px;margin-bottom:8px">Daily check-in</div><h2>How are you feeling today?</h2><p class="mu intro">Choose a number that feels right for you.</p><label for="ls">Pain level</label><div class="pain-value"><strong id="lv">5</strong><span>out of 10</span></div><input class="pain-range" type="range" min="1" max="10" value="5" id="ls" aria-label="Pain level from 1 to 10"><div class="range-labels"><span>Low</span><span>High</span></div><label for="ln" style="margin-top:24px">A note for today <span class="mu" style="font-weight:400">· optional</span></label><textarea class="recovery-note" id="ln" maxlength="160" placeholder="Anything you’d like to remember?"></textarea><button class="btn recovery-submit">Save check-in</button><p class="privacy-note"><span aria-hidden="true">◌</span><span>Your notes stay in this browser and are only for your personal reference.</span></p></form><section class="card recovery-card" aria-label="Recovery progress"><div class="history-title"><div><div class="mu" style="text-transform:uppercase;letter-spacing:.1em;font-size:10px;margin-bottom:8px">Your progress</div><h2>Patterns over time</h2></div><span class="mu" style="font-size:11px">Pain score</span></div><div class="recovery-summary"><div class="metric"><span>Check-ins</span><b>${L.length}</b></div><div class="metric"><span>Average</span><b>${avg}${L.length?'<small style="font-size:11px;color:var(--mu)"> / 10</small>':''}</b></div><div class="metric"><span>Since first</span><b style="font-size:16px">${trend}</b></div></div>${L.length?`<svg class="trend-chart" viewBox="0 0 280 100" role="img" aria-label="Pain score trend across ${L.length} check-ins"><line x1="0" y1="19" x2="280" y2="19" stroke="#262626"/><line x1="0" y1="50" x2="280" y2="50" stroke="#262626"/><line x1="0" y1="81" x2="280" y2="81" stroke="#262626"/><text x="0" y="15" fill="#777" font-size="8">10</text><text x="0" y="96" fill="#777" font-size="8">1</text><polyline points="${points}" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>${L.map((e,k)=>`<circle cx="${L.length<2?140:k*(280/(L.length-1))}" cy="${Math.max(8,Math.min(92,100-e.s*9))}" r="3" fill="#10b981"/>`).join('')}</svg>`:'<div class="empty-chart"><p class="mu">Your progress will appear here after your first check-in.</p></div>'}<div class="history"><div class="history-title"><h3>Recent check-ins</h3><span class="mu" style="font-size:11px">${Math.min(L.length,5)} of ${L.length}</span></div>${ordered.slice(0,5).map(e=>`<div class="history-row"><div><div class="history-date">${date(e)}</div>${e.n?`<div class="history-note">${safe(e.n)}</div>`:''}</div><span class="score-pill"><i></i>${e.s} / 10</span></div>`).join('')||'<p class="mu" style="font-size:12px;margin:14px 0 0">No check-ins yet. Your first one is a good place to begin.</p>'}</div><p class="mu" style="font-size:11px;margin:18px 0 0">This log is for personal tracking and does not provide a diagnosis or replace medical advice.</p></section></div>`},
finder:()=>{const f=S.f,A=['Neck','Shoulder','Elbow','Wrist','Lower back','Knee','Ankle'],pos={Neck:[50,14],Shoulder:[29,20],Elbow:[24,38],Wrist:[20,50],'Lower back':[50,42],Knee:[42,71],Ankle:[42,92]};
const step=f.done?'Recommendation':f.type?'Step 3 of 3':f.area?'Step 2 of 3':'Step 1 of 3',prompt=f.done?'A gentle next step':f.type?'How strong does it feel today?':f.area?'What does it feel like?':'Where are you feeling the strain?',helper=f.done?'Based on the answers you shared.':f.type?'Use the scale below and tell us if there is swelling.':f.area?'Choose the description that feels closest.':'Select an area on the figure or use the buttons below.';
let r=`<div class="finder-step">${step}</div><h2>${prompt}</h2><p class="mu">${helper}</p>`;
if(f.area)r+=`<div class="me">${f.area}</div><div class="tabs">${['Sharp','Dull','Burning','Unstable'].map(t=>`<button class="chip ${f.type==t?'on':''}" data-type="${t}">${t}</button>`).join('')}</div>`;
if(f.type)r+=`<div class="me">${f.type}</div><label class="finder-range-label">Pain today · <b id="iv">${f.int||5}</b> / 10</label><input type="range" min="1" max="10" value="${f.int||5}" id="rg" style="width:100%;accent-color:#10b981"><label class="chip" style="display:inline-flex;align-items:center;gap:8px"><input type="checkbox" id="sw" ${f.sw?'checked':''}>Swelling present</label><p><button class="btn" data-done>Get my recommendation</button></p>`;
if(f.done){const i=REC[f.area],warn=f.int>=8||(f.sw&&f.type=='Unstable');r+=`<div class="ai">${warn?'Your answers suggest a medical assessment first. Please see a doctor before buying gear.':'Thank you. Here is what fits.'}</div><div class="grid recommendation">${card(i)}${card(9)}</div><p class="mu">Guidance only. Not a diagnosis. See a doctor if pain is severe or persists.</p>`}
return `<div class="finder-heading"><div><h1 class="serif">Find my gear</h1><p class="mu">A little guidance, at your pace.</p></div></div><div class="finder-layout"><section class="finder-visual" aria-label="Choose a body area"><div class="finder-figure"><div class="body"><svg viewBox="0 0 200 420" width="200" role="img" aria-label="Human body" style="filter:drop-shadow(0 0 10px rgba(16,185,129,.18))"><defs><radialGradient id="ag1" cx="50%" cy="30%" r="75%"><stop offset="0" stop-color="#4d4d4d"/><stop offset="1" stop-color="#141414"/></radialGradient><linearGradient id="ag2" x1="0" x2="1"><stop offset="0" stop-color="#141414"/><stop offset=".45" stop-color="#474747"/><stop offset="1" stop-color="#161616"/></linearGradient></defs><ellipse cx="100" cy="413" rx="46" ry="5" fill="#000" opacity=".6"/><g stroke="#6a6a6a" stroke-width=".8"><g id="ah"><path fill="url(#ag2)" d="M71 204Q66 242 72 296Q70 304 74 316Q70 350 76 384L74 398Q70 407 78 410L96 410Q99 402 94 396L92 382Q96 350 94 316Q98 304 97 296L101 208Z"/><path fill="url(#ag2)" d="M58 80Q46 84 44 104L40 142Q38 152 40 160L35 204Q33 216 36 228Q42 236 46 226L50 206L56 160Q60 150 60 140L66 100Q66 86 58 80Z"/></g><use href="#ah" transform="translate(200 0) scale(-1 1)"/><path fill="url(#ag2)" d="M92 52Q92 62 88 70L112 70Q108 62 108 52Z"/><path fill="url(#ag1)" d="M62 76Q80 66 100 68Q120 66 138 76Q148 82 146 98L141 134Q137 152 133 170L130 198Q118 210 100 210Q82 210 70 198L67 170Q63 152 59 134L54 98Q52 82 62 76Z"/><ellipse cx="100" cy="34" rx="16" ry="20" fill="url(#ag1)"/></g><g fill="none" stroke="#8a8a8a" stroke-width=".8" opacity=".45"><path d="M76 98Q100 112 124 98M100 112V196M90 128h20M90 148h20M91 168h18M62 84Q70 100 76 98M138 84Q130 100 124 98M80 220Q84 260 82 292M120 220Q116 260 118 292M78 298q6 5 12 0M110 298q6 5 12 0"/></g></svg>${A.map(a=>`<button class="dot ${f.area==a?'on':''}" data-area="${a}" aria-label="${a}" style="left:${pos[a][0]}%;top:${pos[a][1]}%"></button>`).join('')}</div><div class="tabs" style="justify-content:center">${A.map(a=>`<button class="chip ${f.area==a?'on':''}" data-area="${a}">${a}</button>`).join('')}</div></div></section><section class="finder-panel">${r}</section></div>`}};
function render(){try{localStorage.setItem('ariadne-state',JSON.stringify({cart:S.cart,wish:S.wish,log:S.log}))}catch(e){}const out=['welcome','signin'].includes(S.v);$('#app').innerHTML=(out?'':head())+`<main>${views[S.v]()}</main>`;
const n=$('#n');if(n){const u=()=>{$('#cont').disabled=n.value.trim().length<2};n.oninput=u;u();$('#cont').onclick=()=>{S.name=n.value.trim();try{localStorage.setItem('ariadne-name',S.name)}catch(e){}go('signin')}}
const f=$('#f');if(f)f.onsubmit=e=>{e.preventDefault();go('home')}
const lg=$('#lg');if(lg){const s=$('#ls');s.oninput=()=>$('#lv').textContent=s.value;lg.onsubmit=e=>{e.preventDefault();S.log.push({s:+s.value,n:$('#ln').value.trim(),d:new Date().toISOString()});render();toast('Saved. Your thread grows.')}}
const pin=$('#pin');if(pin)pin.oninput=()=>{$('#eta').textContent=/^\d{6}$/.test(pin.value)?'Delivers in 3-5 days. Cash on Delivery available.':'Enter your PIN code for a delivery estimate.'};
const co=$('#co');if(co)co.onsubmit=e=>{e.preventDefault();S.order='ARI'+Math.floor(Math.random()*900000+100000);S.cart={};S.code=null;drawer();go('done')};
const qq=$('#q');if(qq)qq.oninput=()=>{S.q=qq.value.toLowerCase();$('#g').innerHTML=shopList()};
const rg=$('#rg');if(rg){rg.oninput=()=>{S.f.int=+rg.value;$('#iv').textContent=rg.value};$('#sw').onchange=e=>S.f.sw=e.target.checked}}
function drawer(){const ids=Object.keys(S.cart),T=tot(),sub=T.sub;
$('#drawer').innerHTML=`<div class="row"><b>Your cart</b><button class="ghost" data-close>Close</button></div>${ids.length?ids.map(i=>`<div class="row"><span>${P[i][0]}<br><span class="mu">${fmt(P[i][1])}</span></span><span><button class="chip" data-q="${i}:-1">−</button> ${S.cart[i]} <button class="chip" data-q="${i}:1">+</button></span></div>`).join('')+`<p class="mu">${sub>=1500?'Free delivery unlocked.':'Add '+fmt(1500-sub)+' more for free delivery.'}</p><div class="bar"><i style="width:${Math.min(100,sub/15)}%"></i></div><div class="row"><input id="cc" type="text" placeholder="Promo code" value="${S.code?S.code[0]:''}" style="margin:0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:14px"><button class="ghost" data-apply>Apply</button></div>${T.dis?`<div class="row"><span>Discount</span><b>−${fmt(T.dis)}</b></div>`:''}<div class="row"><b>Total</b><b>${fmt(T.t)}</b></div><button class="btn" data-checkout style="width:100%;margin-top:12px">Checkout</button>`:`<p class="mu">Your thread starts here. Add something from the shop.</p>`}`}
document.addEventListener('click',e=>{const t=e.target.closest('button,[data-go]');if(!t)return;const d=t.dataset;
if(d.go)return go(d.go);
if(d.cat){S.cat=d.cat;return render()}
if(d.open){S.p=+d.open;return go('product')}
if(d.sz){S.sz=d.sz;return render()}
if(d.wish){S.wish[d.wish]=!S.wish[d.wish];return render()}
if('help'in d)return $('#hp').classList.add('open');
if('hclose'in d)return $('#hp').classList.remove('open');
if(d.tab){$('#ph').hidden=d.tab=='in';document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('on',b==t));return}
if(d.area){S.f={area:d.area};return render()}
if(d.type){S.f.type=d.type;delete S.f.done;return render()}
if('done'in d){S.f.int=S.f.int||5;S.f.done=1;return render()}
if(d.add){S.cart[d.add]=(S.cart[d.add]||0)+1;toast('Added to cart');render();drawer();return}
if('cart'in d){drawer();return $('#drawer').classList.add('open')}
if('close'in d)return $('#drawer').classList.remove('open');
if(d.q){const[i,n]=d.q.split(':');S.cart[i]+=+n;if(S.cart[i]<1)delete S.cart[i];drawer();return render()}
if('checkout'in d){$('#drawer').classList.remove('open');return go('checkout')}
if('apply'in d){const c=PROMOS.find(p=>p[0]==$('#cc').value.trim().toUpperCase());S.code=c||null;drawer();toast(c?c[0]+' applied':'Code not recognised');return}});
render();drawer();
</script></body></html>
